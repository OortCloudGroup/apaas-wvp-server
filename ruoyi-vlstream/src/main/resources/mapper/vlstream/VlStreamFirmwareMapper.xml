<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vlstream.mapper.VlStreamFirmwareMapper">
    <resultMap id="firmware" type="com.ruoyi.vlstream.domain.VlStreamFirmware">
        <id property="id" column="id"/>
        <result property="cameraModel" column="camera_model"/>
        <result property="target" column="target"/>
        <result property="firmwareVersion" column="firmware_version"/>
        <result property="bucket" column="bucket"/>
        <result property="objectKey" column="object_key"/>
        <result property="originalFileName" column="original_file_name"/>
        <result property="contentType" column="content_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="sha256" column="sha256"/>
        <result property="uploadStatus" column="upload_status"/>
        <result property="uploadExpiresAt" column="upload_expires_at"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <sql id="columns">id,camera_model,target,firmware_version,bucket,object_key,original_file_name,content_type,file_size,sha256,upload_status,upload_expires_at,create_by,create_time,update_time</sql>
    <select id="selectById" resultMap="firmware">select <include refid="columns"/> from wvp_vlstream_firmware where id=#{id}</select>
    <select id="selectByModelAndVersion" resultMap="firmware">
        select <include refid="columns"/> from wvp_vlstream_firmware
        where camera_model=#{cameraModel} and target='rootfs' and firmware_version=#{firmwareVersion} limit 1
    </select>
    <select id="selectReadyByModel" resultMap="firmware">
        select <include refid="columns"/> from wvp_vlstream_firmware
        where camera_model=#{cameraModel} and target='rootfs' and upload_status='READY'
    </select>
    <select id="selectPage" resultMap="firmware">
        select <include refid="columns"/> from wvp_vlstream_firmware
        <where>
            target='rootfs'
            <if test="cameraModel != null and cameraModel != ''">and camera_model like concat('%',#{cameraModel},'%')</if>
            <if test="firmwareVersion != null and firmwareVersion != ''">and firmware_version like concat('%',#{firmwareVersion},'%')</if>
        </where>
        order by create_time desc,id desc limit #{offset},#{limit}
    </select>
    <select id="count" resultType="long">
        select count(*) from wvp_vlstream_firmware
        <where>
            target='rootfs'
            <if test="cameraModel != null and cameraModel != ''">and camera_model like concat('%',#{cameraModel},'%')</if>
            <if test="firmwareVersion != null and firmwareVersion != ''">and firmware_version like concat('%',#{firmwareVersion},'%')</if>
        </where>
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into wvp_vlstream_firmware(camera_model,target,firmware_version,bucket,object_key,original_file_name,content_type,file_size,upload_status,upload_expires_at,create_by,create_time,update_time)
        values(#{cameraModel},'rootfs',#{firmwareVersion},#{bucket},#{objectKey},#{originalFileName},#{contentType},#{fileSize},#{uploadStatus},#{uploadExpiresAt},#{createBy},#{createTime},#{updateTime})
    </insert>
    <update id="markReady">update wvp_vlstream_firmware set upload_status='READY',sha256=#{sha256},update_time=now() where id=#{id} and upload_status='UPLOADING'</update>
    <delete id="deleteById">delete from wvp_vlstream_firmware where id=#{id}</delete>
</mapper>
